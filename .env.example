# Copy this file to the repository root as .env for local development.
# Never commit the real .env file or paste its contents into an issue or log.

# Express API listener
PORT=5555

# MongoDB connection string for a database you own and are authorized to use.
# Use a dedicated least-privilege development user. Do not reuse any credential
# that has previously been committed to a public repository.
MONGODB_URI=mongodb://127.0.0.1:27017/anime_book_store

# Comma-separated browser origins allowed to call the API.
# Add the actual deployed frontend origin in the hosting environment.
CORS_ORIGIN=http://localhost:5173

# Public Vite configuration only. Never put passwords, tokens, or private keys
# in variables prefixed with VITE_, because Vite exposes them to the browser.
VITE_API_BASE_URL=http://localhost:5555
